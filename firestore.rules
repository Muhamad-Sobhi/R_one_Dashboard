rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    /* ---------- public store data (read-only for visitors) ---------- */
    match /workshopSettings/{profileId} {
      allow get: if profileId == 'main';
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shippingRates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* admins always read everything; visitors only see approved/published docs */
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'معتمدة';
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    /* ---------- collected data: admin only ---------- */
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /newsletter/{subscriberId} {
      allow read, write: if isAdmin();
    }

    match /searchLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /productStats/{productId} {
      allow read, write: if isAdmin();
    }

    match /dailyStats/{dayId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}